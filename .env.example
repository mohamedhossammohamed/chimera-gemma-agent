# Copy to .env and fill in your key
# NEVER commit .env to version control
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_KEY
OPENROUTER_MODEL=google/gemma-3-27b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Rate limiting (free tier: 20 req/min, 1M tokens/day)
RATE_LIMIT_RPM=18
RATE_LIMIT_TPM=800000

# Retry / backoff
MAX_RETRIES=3
BASE_BACKOFF_SECONDS=1.0
MAX_BACKOFF_SECONDS=60.0

# PyCox survival head
PYCOX_EPOCHS=50
PYCOX_BATCH_SIZE=32
PYCOX_LR=1e-3

# Embedding fusion
EMBEDDING_SITE_NORM=true